# Copy this file to .env and fill in the values.

# ---------------------------------------------------------
# PostgreSQL credentials (used by docker-compose.yml)
# ---------------------------------------------------------
POSTGRES_USER=qalab
POSTGRES_PASSWORD=qalab_secret
POSTGRES_DB=qalab_shop

# ---------------------------------------------------------
# Database URL
#
# For local development (app runs with npm run dev, DB in Docker):
#   DATABASE_URL="postgresql://qalab:qalab_secret@localhost:5432/qalab_shop"
#
# For fully Dockerized setup (app + DB both in containers):
#   The app container sets this automatically from POSTGRES_* vars.
#   You do NOT need to set DATABASE_URL here in that case.
# ---------------------------------------------------------
DATABASE_URL="postgresql://qalab:qalab_secret@localhost:5432/qalab_shop"

# ---------------------------------------------------------
# Secrets — replace with strong random values in production
# ---------------------------------------------------------
JWT_SECRET="your-super-secret-jwt-key-replace-in-production"
NEXTAUTH_SECRET="your-nextauth-secret-replace-in-production"
NEXTAUTH_URL="http://localhost:3000"
