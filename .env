# Database
# Local development (requires a running PostgreSQL instance, e.g. via: docker compose up db -d)
DATABASE_URL="postgresql://qalab:qalab_secret@localhost:5432/qalab_shop"

# PostgreSQL credentials (used by docker-compose.yml)
POSTGRES_USER=qalab
POSTGRES_PASSWORD=qalab_secret
POSTGRES_DB=qalab_shop

# JWT Secret (replace with a secure secret in production)
JWT_SECRET="your-super-secret-jwt-key-replace-in-production"

# Next.js
NEXTAUTH_SECRET="your-nextauth-secret-replace-in-production"
NEXTAUTH_URL="http://localhost:3000"
